{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alps.dev/schemas/process-model/v1alpha1.schema.json",
  "title": "ALPS Process Model Descriptor v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "alps.dev/process-model/v1alpha1" },
    "kind": { "const": "SkillModel" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processes", "interfaces", "bindings"],
      "properties": {
        "processes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/process" } },
        "interfaces": { "type": "array", "items": { "$ref": "#/$defs/interface" } },
        "bindings": { "type": "array", "items": { "$ref": "#/$defs/binding" } },
        "handoffs": { "type": "array", "items": { "$ref": "#/$defs/handoff" } },
        "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } },
        "entryPoints": { "type": "array", "items": { "type": "object", "required": ["process"], "properties": { "process": { "type": "string" } }, "additionalProperties": false } },
        "labels": { "type": "object" }
      }
    }
  },
  "$defs": {
    "process": { "type": "object", "additionalProperties": false, "required": ["id", "ref"], "properties": { "id": { "type": "string" }, "ref": { "type": "string" } } },
    "interface": { "type": "object", "additionalProperties": false, "required": ["id", "name", "kind"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "kind": { "enum": ["artifact", "information"] }, "mediaTypes": { "type": "array", "items": { "type": "string" } }, "schemaRef": { "type": "string" }, "required": { "type": "boolean" } } },
    "binding": { "type": "object", "additionalProperties": false, "required": ["id", "process", "role", "item", "interface"], "properties": { "id": { "type": "string" }, "process": { "type": "string" }, "role": { "enum": ["input", "output"] }, "item": { "type": "string" }, "interface": { "type": "string" }, "optional": { "type": "boolean" } } },
    "handoff": { "type": "object", "additionalProperties": false, "required": ["id", "from", "to"], "properties": { "id": { "type": "string" }, "from": { "type": "string" }, "to": { "type": "string" }, "acceptanceRef": { "type": "string" } } },
    "relationship": { "type": "object", "additionalProperties": false, "required": ["type", "processes"], "properties": { "type": { "enum": ["iteration", "recursion", "concurrency", "integration"] }, "processes": { "type": "array", "minItems": 1, "items": { "type": "string" } } } }
  }
}
